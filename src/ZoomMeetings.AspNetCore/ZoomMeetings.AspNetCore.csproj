<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Package Metadata adhering to Microsoft Package Authoring Best Practices -->
    <PackageId>ZoomMeetings.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>Modi97</Authors>
    <Description>ASP.NET Core integration for ZoomMeetings: AddZoomMeetings(...) DI registration (with keyed-service support for a second "sandbox" Zoom account/app) and a Minimal API webhook endpoint that verifies Zoom's X-Zm-Signature and answers the endpoint.url_validation handshake.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>zoom;zoom-api;zoom-meetings;aspnetcore;dependency-injection;webhook;webhooks;oauth2;dotnet;csharp;api-client;sdk;server-to-server-oauth</PackageTags>
    <PackageReleaseNotes>0.1.0: Initial release.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/JoseModi97/zoom-meetings-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JoseModi97/zoom-meetings-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <!-- Microsoft.Extensions.Http / DependencyInjection.Abstractions / Configuration.Binder are
         already provided by the Microsoft.AspNetCore.App FrameworkReference above on net8.0/net10.0,
         so they're intentionally not repeated here as explicit PackageReferences. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoomMeetings\ZoomMeetings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('..\..\icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

</Project>
